#!/usr/bin/env node

const { Command } = require('commander');
const path = require('path');
const fs = require('fs');
const WebPConverter = require('../lib/index');

const program = new Command();

function formatBytes(bytes) {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

program
  .name('webp-converter')
  .description('WebP 图片转换器 - 支持 MCP 协议，可通过大模型调用')
  .version('1.0.0')
  .argument('[directory]', '要转换的图片目录或文件', '.')
  .option('-q, --quality <number>', 'WebP 图片质量 (1-100)', '80')
  .option('-o, --output <directory>', '输出目录')
  .action(async (directory, options) => {
    try {
      const converter = new WebPConverter({
        quality: parseInt(options.quality)
      });

      const inputPath = path.resolve(directory);

      console.log('');
      console.log('  WebP Converter v1.1.0');
      console.log('  ====================');
      console.log(`  质量参数: ${options.quality}`);
      console.log('');

      if (fs.existsSync(inputPath) && fs.statSync(inputPath).isFile()) {
        const result = await converter.convertSingleImage(inputPath, options.output);

        if (result.success) {
          console.log(`  ✓ ${path.basename(result.input)} (${result.format} ${result.width}x${result.height})`);
          console.log(`    原始尺寸: ${formatBytes(result.originalSize)}`);
          console.log(`    转换尺寸: ${formatBytes(result.convertedSize)}`);
          const sign = result.savedPercent >= 0 ? '↓' : '↑';
          const pct = Math.abs(result.savedPercent);
          console.log(`    优化比例: ${sign} ${pct}% (${formatBytes(Math.abs(result.savedBytes))})`);
          console.log(`    输出路径: ${result.output}`);
        } else {
          console.error(`  ✗ ${result.input}: ${result.error}`);
          process.exit(1);
        }
      } else {
        const outputDir = options.output ? path.resolve(options.output) : null;

        console.log(`  输入目录: ${inputPath}`);
        if (outputDir) {
          console.log(`  输出目录: ${outputDir}`);
        }
        console.log('');

        const results = await converter.convertDirectory(inputPath, outputDir);

        let successCount = 0;
        let failCount = 0;
        let totalOriginal = 0;
        let totalConverted = 0;

        results.forEach(result => {
          if (result.success) {
            successCount++;
            totalOriginal += result.originalSize;
            totalConverted += result.convertedSize;
            const sign = result.savedPercent >= 0 ? '↓' : '↑';
            const pct = Math.abs(result.savedPercent).toFixed(2);
            console.log(`  ✓ ${path.basename(result.input)} (${result.format} ${result.width}x${result.height}) ${formatBytes(result.originalSize)} → ${formatBytes(result.convertedSize)} ${sign} ${pct}%`);
          } else {
            failCount++;
            console.error(`  ✗ ${path.basename(result.input)}: ${result.error}`);
          }
        });

        console.log('');
        console.log('  ────────────────────────────────');
        console.log(`  转换完成: ${successCount} 成功, ${failCount} 失败`);
        if (successCount > 0) {
          const totalSaved = totalOriginal - totalConverted;
          const totalPct = totalOriginal > 0 ? (totalSaved / totalOriginal * 100).toFixed(2) : '0.00';
          const sign = totalSaved >= 0 ? '↓' : '↑';
          console.log(`  总计: ${formatBytes(totalOriginal)} → ${formatBytes(totalConverted)} ${sign} ${Math.abs(totalPct)}% (${formatBytes(Math.abs(totalSaved))})`);
        }
      }
      console.log('');
    } catch (error) {
      console.error('错误:', error.message);
      process.exit(1);
    }
  });

program.parse();
